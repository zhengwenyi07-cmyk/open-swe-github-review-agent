{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-swe-github-review-agent/review.schema.json",
  "title": "Local Open SWE Code Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commit_sha",
    "summary",
    "findings",
    "uncertainties",
    "tests",
    "decision"
  ],
  "properties": {
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    },
    "tests": {
      "$ref": "#/$defs/tests"
    },
    "decision": {
      "enum": ["APPROVE", "COMMENT", "REQUEST_CHANGES"]
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "severity",
        "category",
        "assessment",
        "evidence",
        "recommendation"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "severity": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "category": {
          "enum": ["correctness", "security", "maintainability", "testing"]
        },
        "assessment": {
          "enum": ["confirmed", "suggestion"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "question", "evidence_needed"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence_needed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "tests": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["commands", "passed"],
          "properties": {
            "commands": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "passed": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "commands", "passed"],
          "properties": {
            "status": {"const": "NOT_RUN_READ_ONLY"},
            "commands": {"type": "array", "maxItems": 0},
            "passed": {"const": false}
          }
        }
      ]
    }
  }
}
